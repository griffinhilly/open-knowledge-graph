#!/bin/bash
# Pre-push hook for Open Knowledge Graph
#
# 1. Checks all scripts referenced in CI workflow are tracked in git
# 2. If domain/ files changed: runs validate.py --quick (cycles, dupes, schema)
#
# Skip with: git push --no-verify

REPO_ROOT="$(git rev-parse --show-toplevel)"
WORKFLOW="$REPO_ROOT/.github/workflows/deploy-pages.yml"

# --- Step 1: Check CI-referenced scripts exist in repo ---
if [ -f "$WORKFLOW" ]; then
    missing=0
    while IFS= read -r script; do
        if ! git ls-files --error-unmatch "$script" &>/dev/null; then
            echo "pre-push: CI workflow references '$script' but it's not tracked in git"
            missing=1
        fi
    done < <(grep -oP '(?<=python )tools/[^ ]+' "$WORKFLOW")

    if [ "$missing" -eq 1 ]; then
        echo "pre-push: BLOCKED - commit missing scripts before pushing"
        exit 1
    fi
fi

# --- Step 2: Per-commit checks (dialectic trailer) + domain-change detection ---
# Dialectic gate (designed Apr 12 2026 review, built Jun 12 2026): substantial
# commits (>=5 non-md files OR >=200 non-md LoC) must carry a
# "dialectic-reviewed:" or "dialectic-skipped:<reason>" trailer. Makes the
# skip a typed decision instead of a silent default.
has_domain_changes=0
gate_violations=""

while read local_ref local_sha remote_ref remote_sha; do
    # Skip branch deletion
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        continue
    fi

    # Determine comparison range
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        # New branch - compare against merge-base with master
        base=$(git merge-base "$local_sha" origin/master 2>/dev/null)
        if [ -z "$base" ]; then
            base="$local_sha~1"
        fi
        range="$base..$local_sha"
    else
        range="$remote_sha..$local_sha"
    fi

    # Dialectic-trailer check on each non-merge commit in the range
    for c in $(git rev-list --no-merges "$range" 2>/dev/null); do
        if git log -1 --format=%B "$c" | grep -qiE '^dialectic-(reviewed|skipped):'; then
            continue
        fi
        counts=$(git show --numstat --format= "$c" 2>/dev/null | awk '$3 !~ /\.md$/ {f++; loc+=$1+$2} END {printf "%d %d", f+0, loc+0}')
        cfiles=${counts% *}
        cloc=${counts#* }
        if [ "$cfiles" -ge 5 ] || [ "$cloc" -ge 200 ]; then
            gate_violations="$gate_violations\n  $(git log -1 --format='%h %s' "$c")  [$cfiles files / $cloc LoC, non-md]"
        fi
    done

    # Check if any domain files changed in the push range
    if git diff --name-only "$range" -- domains/ 2>/dev/null | grep -q .; then
        has_domain_changes=1
    fi
done

if [ -n "$gate_violations" ]; then
    echo "pre-push: BLOCKED - substantial commit(s) without a dialectic trailer:"
    echo -e "$gate_violations"
    echo ""
    echo "  Add to the commit message one of:"
    echo "    dialectic-reviewed: <mode/summary>"
    echo "    dialectic-skipped: <one-line reason>"
    echo "  (git commit --amend, or git push --no-verify to override)"
    exit 1
fi

if [ "$has_domain_changes" -eq 1 ]; then
    echo "pre-push: Domain files changed, running quick validation..."
    PYTHONIOENCODING=utf-8 python "$REPO_ROOT/tools/validate.py" --quick
    result=$?
    if [ "$result" -ne 0 ]; then
        echo "pre-push: BLOCKED - validation failed (run 'python tools/validate.py' for full report)"
        exit 1
    fi
    echo "pre-push: Validation passed"

    # --- Step 3: Quiz data staleness check ---
    QUIZ_DATA="$REPO_ROOT/output/assessment-questions.json"
    if [ -f "$QUIZ_DATA" ]; then
        quiz_ts=$(stat -c %Y "$QUIZ_DATA" 2>/dev/null || stat -f %m "$QUIZ_DATA" 2>/dev/null)
        newest_topic=$(find "$REPO_ROOT/domains" -name "*.md" ! -name "_*" -newer "$QUIZ_DATA" 2>/dev/null | head -1)
        if [ -n "$newest_topic" ]; then
            echo ""
            echo "pre-push: WARNING - Quiz data may be stale!"
            echo "  Topic files modified after assessment-questions.json was generated."
            echo "  Run: python tools/generate_assessment_questions.py && python tools/generate_quiz_page.py"
            echo "  (Push continues — this is a warning, not a blocker)"
            echo ""
        fi
    fi
fi

exit 0
